{
    "name": "softspring/response-headers",
    "description": "This component provides response headers configuration for Symfony projects",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "symfony/http-foundation": "^6.4|^7.4|^8.0",
        "symfony/event-dispatcher": "^6.4|^7.4|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.5 || ^10.0",
        "rector/rector": "^2.2",
        "symfony/expression-language": "^6.4|^7.4|^8.0",
        "symfony/http-kernel": "^6.4|^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\ResponseHeaders\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\Component\\ResponseHeaders\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
